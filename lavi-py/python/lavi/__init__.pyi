from typing import Any, Callable, Dict, Optional, Union

class Value:
    def __init__(self, val: Any = None) -> None: ...
    def is_null(self) -> bool: ...
    def is_bool(self) -> bool: ...
    def is_number(self) -> bool: ...
    def is_str(self) -> bool: ...
    def is_array(self) -> bool: ...
    def is_object(self) -> bool: ...
    def as_bool(self) -> Optional[bool]: ...
    def as_float(self) -> Optional[float]: ...
    def as_int(self) -> Optional[int]: ...
    def as_str(self) -> Optional[str]: ...
    def get(self, key: str, default: Any = None) -> Any: ...
    def __getitem__(self, key: Union[str, int]) -> Value: ...
    def __contains__(self, key: str) -> bool: ...
    def __len__(self) -> int: ...
    def __bool__(self) -> bool: ...
    def __eq__(self, other: Any) -> bool: ...
    def to_python(self) -> Any: ...

class SimulatedClock:
    def __init__(self, initial_ms: int = 0) -> None: ...
    def now(self) -> int: ...
    def set(self, target_ms: int) -> None: ...
    def increment(self, dt_ms: int) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> SimulatedClock: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

class Machine:
    def __init__(self, json_config: str, clock: Optional[SimulatedClock] = None) -> None: ...
    def start(self) -> Machine: ...
    def stop(self) -> None: ...
    def close(self) -> None: ...
    def get_context(self) -> Value: ...
    @property
    def context(self) -> Value: ...
    def matches(self, state_path: str) -> bool: ...
    def can(self, event: str, payload: Optional[Union[Dict[str, Any], str]] = None) -> bool: ...
    def has_tag(self, tag: str) -> bool: ...
    def is_done(self) -> bool: ...
    def send(self, event: Union[str, Dict[str, Any]], payload: Optional[Union[Dict[str, Any], str]] = None) -> None: ...
    def tick(self) -> None: ...
    def get_next_deadline(self) -> Optional[int]: ...
    def get_snapshot(self) -> str: ...
    def restore_snapshot(self, snapshot_json: str) -> None: ...
    def register_action(self, name: str, callback: Callable[[Value, Value], None]) -> Machine: ...
    def register_guard(self, name: str, callback: Callable[[Value, Value], bool]) -> Machine: ...
    def register_clock(self, callback: Union[Callable[[], int], SimulatedClock]) -> Machine: ...
    def action(self, name: str) -> Callable[[Callable[[Value, Value], None]], Callable[[Value, Value], None]]: ...
    def guard(self, name: str) -> Callable[[Callable[[Value, Value], bool]], Callable[[Value, Value], bool]]: ...
    def clock(self, callback: Optional[Callable[[], int]] = None) -> Union[Callable[[], int], Callable[[Callable[[], int]], Callable[[], int]]]: ...
    def __enter__(self) -> Machine: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
