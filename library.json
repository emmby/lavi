{
  "name": "lavi",
  "version": "0.1.1",
  "description": "Lavi statechart runtime for C/C++ and PlatformIO (XState v5 compatible), powered by Rust.",
  "keywords": [
    "lavi",
    "xstate",
    "fsm",
    "state-machine",
    "statechart",
    "rust",
    "ffi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/emmby/lavi.git"
  },
  "build": {
    "extraScript": "build_rust.py",
    "includeDir": "lavi-c-cpp/include",
    "srcFilter": [
      "-<*>"
    ]
  },
  "export": {
    "include": [
      "Cargo.toml",
      "Cargo.lock",
      "build_rust.py",
      "lavi/**",
      "lavi-c-cpp/Cargo.toml",
      "lavi-c-cpp/src/**",
      "lavi-c-cpp/include/**",
      "lavi-wasm/Cargo.toml",
      "lavi-wasm/src/**",
      "examples/esp32/**"
    ]
  },
  "frameworks": [
    "*"
  ],
  "platforms": [
    "*"
  ]
}
